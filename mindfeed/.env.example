# Copy to .env for local configuration. Change secrets and URLs before public deployment.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
# Local default is SQLite. For PostgreSQL, use the example below.
DATABASE_URL=sqlite:///./mindfeed.db
# DATABASE_URL=postgresql+psycopg://mindfeed:change-this-password@localhost:5432/mindfeed
ENABLE_DEMO_LOGIN=true
PUBLIC_SITE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Optional real moderation provider. Without a key, MindFeed uses transparent local demo rules.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Optional analytics measurement ID; only configure after consent/privacy behavior is reviewed.
VITE_GA_MEASUREMENT_ID=
# SMS verification: development never sends real SMS; use twilio only with real credentials.
SMS_MODE=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# In development, show the generated code in the response for local testing only.
DEV_EXPOSE_OTP=true
MAX_UPLOAD_MB=20
